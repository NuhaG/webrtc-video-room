<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Video App Home</title>
    <link rel="stylesheet" href="/home.css" />
  </head>
  <body>
    <div class="container">
      <h1>Welcome to Video App</h1>
      <p>Collaboration made simple for study groups</p>
      
      <input type="text" id="nameInput" placeholder="Enter Your Name" required />
      
      <form id="createForm">
        <button type="submit">Join New Room</button>
      </form>
      <p>Or Join Using Room Code</p>
      <form id="joinForm">
        <input type="text" id="roomInput" placeholder="Enter Room Code" required/> 
        <button type="submit" class="join-btn">Join</button>
      </form>      
    </div>

    <script>
      const savedName = sessionStorage.getItem("webrtc_username") || localStorage.getItem("webrtc_username");
      if (savedName) {
        document.getElementById("nameInput").value = savedName;
      }

      function getName() {
        const name = document.getElementById("nameInput").value.trim();
        if (!name) {
          alert("Please enter your name first.");
          return null;
        }
        sessionStorage.setItem("webrtc_username", name);
        localStorage.setItem("webrtc_username", name);
        return name;
      }

      document.getElementById("createForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const name = getName();
        if (name) {
          window.location.href = `/room?name=${encodeURIComponent(name)}`;
        }
      });

      document.getElementById("joinForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const name = getName();
        if (!name) return;
        const roomCode = document.getElementById("roomInput").value.trim();
        if (roomCode) {
          window.location.href = `/room/${roomCode}?name=${encodeURIComponent(name)}`;
        }
      });
    </script>
  </body>
</html>
