<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- gets room id from the server -->
    <script>
      const ROOM_ID = "<%= roomId %>";
    </script>
    <!-- peerjs handles WebRTC peer-to-peer video calls  -->
    <script
      src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"
      defer
    ></script>
    <!-- connects server for signals -->
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="/script.js" defer></script>
    <title>Room</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div id="video-grid"></div>

    <!-- Raised Hands Sidebar -->
    <div id="queueSidebar" class="queue-sidebar hidden">
      <div class="queue-sidebar-header">
        <h3><i class="fas fa-hand"></i> Raised Hands (<span id="modalQueueCount">0</span>)</h3>
        <button id="closeQueueSidebar" class="close-sidebar-btn">&times;</button>
      </div>
      <div id="queueList" class="queue-sidebar-body">
        <div class="queue-empty">No hands raised</div>
      </div>
    </div>

    <div id="controls">
      <div id="roomCode">
        <h1 id="roomCodeNo"></h1>
        <h3 id="copyStatus"></h3>
      </div>

      <button id="muteButton" class="control-btn" title="Toggle Mic">
        <i id="muteIcon" class="fas fa-microphone"></i>
      </button>
      <button id="videoButton" class="control-btn" title="Toggle Camera">
        <i id="videoIcon" class="fas fa-video"></i>
      </button>
      <button id="leaveButton" class="control-btn leave" title="Leave">
        <i class="fas fa-phone-slash"></i>
      </button>
      <button id="hand" class="control-btn" title="Raise Hand">
        <i class="fas fa-hand"></i>
      </button>
      <button id="queueBtn" class="control-btn" title="Raised Hands Queue">
        <i class="fas fa-users"></i>
        <span id="queueBadge">0</span>
      </button>
    </div>
  </body>
</html>

